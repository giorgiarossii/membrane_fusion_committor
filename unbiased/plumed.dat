LOAD FILE=/home/grossi1-iit.local/giorgia/membrane/committor/template/coordination_multi.so
LOAD FILE=/home/grossi1-iit.local/giorgia/membrane/committor/template/MemFusionP_NP.so

# =================================================== INDEX FILES ===================================================

NP: GROUP NDX_FILE=index.ndx NDX_GROUP=NP
tails: GROUP NDX_FILE=index.ndx NDX_GROUP=tails
innerheads: GROUP NDX_FILE=index.ndx NDX_GROUP=innerheads
mus: GROUP NDX_FILE=index.ndx NDX_GROUP=MUS
mus4: GROUP NDX_FILE=index.ndx NDX_GROUP=MUS4

com: CENTER ATOMS=NP

memFusion: MEMFUSIONP_G NP=com TAILS=tails NSMEM=20 DSMEM=0.1 ZSHIFT=1.1 RCYLMEM=2.0

c_mus4: COORDINATION GROUPA=mus4 GROUPB=innerheads R_0=0.8 NLIST NL_CUTOFF=1.1 NL_STRIDE=1

# =================================================== COORDINATION ===================================================

c_tails: COORDINATION_MULTI GROUPA=com GROUPB=tails D_0=0.0 R_0=1.6,1.7,1.8,1.9,2.0,2.1,2.2,2.3,2.4,2.5,2.6,2.7,2.8,2.9,3.0,3.1,3.2,3.3 NN=50 MM=100 D_MAX=3.6 NLIST NL_CUTOFF=3.8 NL_STRIDE=1 N_OUT=18 Z_SHIFT=1 XY_RADIUS=2

c_0: CUSTOM VAR=x,y ARG=c_tails.0,c_tails.1 FUNC=y-x PERIODIC=NO
c_1: CUSTOM VAR=x,y ARG=c_tails.1,c_tails.2 FUNC=y-x PERIODIC=NO
c_2: CUSTOM VAR=x,y ARG=c_tails.2,c_tails.3 FUNC=y-x PERIODIC=NO
